#!/bin/sh
#|-*- mode:lisp -*-|#
#|
exec ros -Q -- $0 "$@"
|#
(progn ;;init forms
  (ros:ensure-asdf)
  #+quicklisp
  (ql:quickload '(reblocks-ui2-demo) :silent t)
  )

(defpackage :ros.script.reblocks-ui2-demo
  (:use :cl))
(in-package :ros.script.reblocks-ui2-demo)

(defun main (&rest argv)
  (declare (ignorable argv))
  (reblocks-ui2-demo/server:start)
  (loop do (sleep 5)))
;;; vim: set ft=lisp lisp:
